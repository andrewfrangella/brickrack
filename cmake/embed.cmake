# Converts a binary file into a C++ header (kEmbeddedFont / kEmbeddedFontSize).
file(READ ${INPUT} HEX_CONTENT HEX)
string(LENGTH "${HEX_CONTENT}" HEX_LEN)
math(EXPR BYTE_LEN "${HEX_LEN} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX_CONTENT}")
string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" BYTES "${BYTES}")
file(WRITE ${OUTPUT}
  "// Generated by cmake/embed.cmake - do not edit.\n#pragma once\n#include <cstddef>\n#include <cstdint>\n"
  "static const uint8_t kEmbeddedFont[] = {\n${BYTES}\n};\n"
  "static const size_t kEmbeddedFontSize = ${BYTE_LEN};\n")
